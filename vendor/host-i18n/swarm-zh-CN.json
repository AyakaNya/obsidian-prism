      "replacement": "/ $1"
    },
    {
      "regex": "^of (\\d+) · #(\\d+) at ([^()]+) \\(\\+([^)]+)\\)$",
      "replacement": "/ $1 · #$2 · $3 (+$4)"
    },
    {
      "regex": "^read #(\\d+) · updated ([0-9a-zA-Z .<>]+ ago)$",
      "replacement": "已讀至 #$1 · 更新於 $2"
    },
    {
      "regex": "^read #(\\d+)$",
      "replacement": "已讀至 #$1"
    },
